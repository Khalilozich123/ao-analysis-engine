# Environment template — COMMITTED to git (contains NO real secrets).
#
# HOW TO USE: copy this file to `.env` (same folder) and fill in your real key:
#     cp backend/.env.example backend/.env      (Git Bash)
#     copy backend\.env.example backend\.env    (PowerShell / CMD)
# The real `.env` is gitignored and must never be committed.

# Scorer: "keyword" (free, offline, instant — default) or "llm" (Gemini multi-agent crew).
SCORER=keyword

# Which LLM provider the factory in app/llm.py should build (used only when SCORER=llm).
# Phase 1 implements "google". The code is written to be swappable later (openai, groq, ...).
LLM_PROVIDER=google

# Google Gemini — get a FREE key at https://aistudio.google.com  ("Get API key", no card needed).
GOOGLE_API_KEY=

# Which Gemini model to call. Flash models are fast and free-tier friendly.
GEMINI_MODEL=gemini-3.6-flash

# --- Reserved for later phases (leave as-is for now) ---
# Postgres connection (used in Phase 4). Matches docker-compose.yml.
DATABASE_URL=postgresql+psycopg://opp:opp_dev_password@db:5432/opportunities
